{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/Dockerfile.api"
  },
  "deploy": {
    "healthcheckPath": "/health",
    "multiRegionConfig": {
      "us-east4-eqdc4a": {
        "numReplicas": 1
      }
    },
    "requiredMountPath": "/data",
    "sleepApplication": true
  }
}
