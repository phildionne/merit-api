FROM python:3.10-slim

# Rasterio wheels depend on system libraries like expat.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libexpat1 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY api/requirements.txt /app/requirements.txt
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ONLY_BINARY=rasterio \
    PYTHONUNBUFFERED=1
RUN python -m pip install --no-cache-dir -r /app/requirements.txt

COPY api /app/api

ENV PORT=8000
ENV DEM_PATH=/data/mosaic/canada_elv.vrt
ENV WEB_CONCURRENCY=1
ENV LOG_LEVEL=info

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\", \"8000\")}/health', timeout=3).read()" || exit 1

CMD ["sh", "-c", "gunicorn -c python:api.gunicorn_conf -k uvicorn.workers.UvicornWorker -w ${WEB_CONCURRENCY:-1} -b 0.0.0.0:${PORT:-8000} --log-level ${LOG_LEVEL:-info} api.app:app"]
