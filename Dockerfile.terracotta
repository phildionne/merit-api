FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libexpat1 \
  && rm -rf /var/lib/apt/lists/*

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ONLY_BINARY=rasterio

ARG TERRACOTTA_VERSION=0.10.1
RUN python -m pip install --no-cache-dir terracotta==${TERRACOTTA_VERSION}

ENV PORT=8080

CMD ["terracotta", "serve", "-r", "/data/overlays/{tile}_{layer}_{band}.vrt", "--port", "8080", "--allow-all-ips"]
